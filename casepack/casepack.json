{
  "packId": "kr1201-agedepth",
  "title": "岩芯年代尺：深度锚点、沉积速率与多候选模型谱系",
  "narrative": "沉积学小组把岩芯 KR-1201 的分段、年龄锚点和事件层组成深度年龄模型，保留多套可辩护候选。",
  "datum": { "depth": "mbsf（海底以下米）", "age": "ka BP（校正后）", "reservoir": "ka（海洋储层偏移 ΔR）" },
  "materials": [
    { "type": "segment", "id": "seg-A", "coreId": "KR-1201", "top": { "raw": "0.00", "unit": "mbsf" }, "base": { "raw": "4.20", "unit": "mbsf" }, "kind": "sediment", "facies": "粉砂质黏土" },
    { "type": "segment", "id": "gap-1", "coreId": "KR-1201", "top": { "raw": "4.20", "unit": "mbsf" }, "base": { "raw": "4.20", "unit": "mbsf" }, "kind": "gap", "facies": "取芯缺口" },
    { "type": "segment", "id": "seg-B", "coreId": "KR-1201", "top": { "raw": "4.20", "unit": "mbsf" }, "base": { "raw": "7.80", "unit": "mbsf" }, "kind": "sediment", "facies": "砂质粉砂" },
    { "type": "segment", "id": "unc-1", "coreId": "KR-1201", "top": { "raw": "7.80", "unit": "mbsf" }, "base": { "raw": "7.80", "unit": "mbsf" }, "kind": "unconformity", "facies": "侵蚀不整合面" },
    { "type": "segment", "id": "seg-C", "coreId": "KR-1201", "top": { "raw": "7.80", "unit": "mbsf" }, "base": { "raw": "11.50", "unit": "mbsf" }, "kind": "sediment", "facies": "块状粉砂" },

    { "type": "anchor", "id": "anc-01", "segmentId": "seg-A", "depth": { "raw": "0.35", "unit": "mbsf" },
      "age": { "kind": "samples", "unit": "ka BP", "values": [1.05, 1.12, 1.18, 1.21, 1.25, 1.31, 1.38] },
      "reservoirOffset": null, "source": "AMS14C-Planktonic-Lot1" },
    { "type": "anchor", "id": "anc-02", "segmentId": "seg-A", "depth": { "raw": "2.10", "unit": "mbsf" },
      "age": { "kind": "samples", "unit": "ka BP", "values": [4.31, 4.42, 4.50, 4.55, 4.61, 4.72, 4.88] },
      "reservoirOffset": null, "source": "AMS14C-Planktonic-Lot1" },
    { "type": "anchor", "id": "anc-03", "segmentId": "seg-A", "depth": { "raw": "3.90", "unit": "mbsf" },
      "age": { "kind": "samples", "unit": "ka BP", "values": [7.85, 7.95, 8.02, 8.10, 8.18, 8.30, 9.60, 11.20, 14.80] },
      "reservoirOffset": null, "source": "AMS14C-Mixed-Lot2（长尾分布）" },
    { "type": "anchor", "id": "anc-04", "segmentId": "seg-B", "depth": { "raw": "4.55", "unit": "mbsf" },
      "age": { "kind": "samples", "unit": "ka BP", "values": [9.55, 9.70, 9.82, 9.90, 10.02, 10.15, 10.31] },
      "reservoirOffset": { "raw": "0.38", "unit": "ka", "datum": "Marine20 ΔR" }, "source": "AMS14C-Benthic-Lot3" },
    { "type": "anchor", "id": "anc-05", "segmentId": "seg-B", "depth": { "raw": "6.20", "unit": "mbsf" },
      "age": { "kind": "samples", "unit": "ka BP", "values": [12.10, 12.25, 12.38, 12.45, 12.55, 12.70, 12.88] },
      "reservoirOffset": { "raw": "0.38", "unit": "ka", "datum": "Marine20 ΔR" }, "source": "AMS14C-Benthic-Lot3" },
    { "type": "anchor", "id": "anc-06", "segmentId": "seg-C", "depth": { "raw": "8.10", "unit": "mbsf" },
      "age": { "kind": "samples", "unit": "ka BP", "values": [24.6, 24.9, 25.1, 25.4, 25.7, 26.0, 26.4] },
      "reservoirOffset": null, "source": "AMS14C-Planktonic-Lot4" },
    { "type": "anchor", "id": "anc-07", "segmentId": "seg-C", "depth": { "raw": "10.90", "unit": "mbsf" },
      "age": { "kind": "samples", "unit": "ka BP", "values": [30.5, 30.8, 31.0, 31.2, 31.5, 31.9, 32.4] },
      "reservoirOffset": null, "source": "AMS14C-Planktonic-Lot4" },
    { "type": "anchor", "id": "anc-08-bad", "segmentId": "seg-B", "depth": { "raw": "约5.0?", "unit": "mbsf" },
      "age": { "kind": "samples", "unit": "ka BP", "values": [11.0, 11.1, 11.2] },
      "reservoirOffset": null, "source": "手写标签无法转换，保留原位并附诊断" },

    { "type": "eventLayer", "id": "ely-01", "segmentId": "seg-A", "depth": { "raw": "2.10", "unit": "mbsf" },
      "name": "火山灰层 T-KR1", "correlatedEventId": "EVT-ASH-4.55ka" },
    { "type": "eventLayer", "id": "ely-02", "segmentId": "seg-C", "depth": { "raw": "8.10", "unit": "mbsf" },
      "name": "浊积事件层 T-KR2", "correlatedEventId": "EVT-TURB-25.4ka" }
  ],
  "script": [
    { "op": "import", "note": "初始导入：深度基准、分段缺口、放射性年龄分布、储层偏移、事件层相关和所有排除决定均保留" },
    { "op": "reviseParameter", "version": "params/v2", "monotonicToleranceKa": 0.15,
      "reason": "参数修订：允许 0.15 ka 内的同龄倒置（生物扰动容忍）" },
    { "op": "changeSource", "replaces": "anc-05",
      "material": { "type": "anchor", "id": "anc-05-v2", "segmentId": "seg-B", "depth": { "raw": "6.35", "unit": "mbsf" },
        "age": { "kind": "samples", "unit": "ka BP", "values": [12.10, 12.25, 12.38, 12.45, 12.55, 12.70, 12.88] },
        "reservoirOffset": { "raw": "0.38", "unit": "ka", "datum": "Marine20 ΔR" }, "source": "AMS14C-Benthic-Lot3-复测深度" },
      "note": "只影响局部依赖的源数据改动：仅 seg-B 需要重算" },
    { "op": "decision", "action": "accept", "target": "candidate:seg-B", "rationale": "接受 seg-B 主候选：复测深度与事件层一致" },
    { "op": "decision", "action": "reject", "target": "candidate:seg-B", "rationale": "互相冲突的人工决定：另一位审阅者否定同一候选，两条决定都保留" }
  ],
  "scenarios": [
    { "id": "depth-duplicate", "title": "深度重复", "mutate": "add-anchor", "anchor": { "id": "anc-02b", "segmentId": "seg-A", "depth": 2.10, "age": [4.90, 5.05, 5.20] },
      "expect": "DEPTH_DUPLICATE 诊断 + 并列锚点各自成候选" },
    { "id": "unconformity-boundary", "title": "不整合是显式边界", "mutate": "none",
      "expect": "没有任何候选跨越 unc-1；seg-B 与 seg-C 各自单调" },
    { "id": "inverted-section", "title": "倒置层段", "mutate": "replace-age", "anchorId": "anc-03", "age": [0.8, 0.9, 1.0],
      "expect": "INVERTED_SECTION 诊断；原序列为 rejected 候选，排除单锚后得到 accepted 候选" },
    { "id": "tied-anchors", "title": "并列锚点", "mutate": "add-anchor", "anchor": { "id": "anc-06b", "segmentId": "seg-C", "depth": 8.10, "age": [25.2, 25.5, 25.8] },
      "expect": "同一深度两个锚点保留为等优候选，不合并" },
    { "id": "long-tail", "title": "年龄分布长尾", "mutate": "none",
      "expect": "anc-03 的 p95 远离中位数；不确定度带不对称；分布未被均值替代" },
    { "id": "local-recompute", "title": "局部重算", "mutate": "scripted-source-change",
      "expect": "改动 anc-05 后仅 seg-B 标记 Recomputed=true" },
    { "id": "concurrent-freeze", "title": "并发冻结", "mutate": "double-freeze",
      "expect": "第一次冻结 frozen，第二次 conflict，两次尝试都留痕" }
  ]
}
