<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgeDepth</RootNamespace>
    <AssemblyName>AgeDepth.Web</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\casepack\*.json" CopyToOutputDirectory="PreserveNewest" Link="casepack\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
