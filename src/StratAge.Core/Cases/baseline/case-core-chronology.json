  "title": "岩芯年代尺：深度锚点、沉积速率与多候选模型谱系",
  "narrative": "沉积学小组把 Lake Hakanoa-3 岩芯切分为三个连续层段 S-1/S-2/S-3，层段间由一条取芯缺口(GAP)与一条不整合(UNCONFORMITY)显式分隔；S-3 是经构造倒转的层段。放射性碳(含湖水储层偏移)、两层火山灰事件层与一个长尾 Student-t 锚点共同组成深度-年龄模型。重复深度与无法转换的材料被保留但标记，全部等优候选必须留档。这是针对岩芯年代尺的专门领域案例，不是通用表格。",
  "coreId": "HKA-3",
  "depthDatum": "mbsf",
  "timeBasis": "ka BP",
  "referenceYear": 1950,
  "segments": [
    { "id": "S-1", "name": "Upper mud (continuous)", "topDepthRaw": "0 mbsf", "baseDepthRaw": "11.8 mbsf", "boundaryBelow": "Gap",
      "note": "连续湖相泥，0-11.8 mbsf；年龄随深度单调变老。" },
    { "id": "S-2", "name": "Middle silt (across unconformity)", "topDepthRaw": "12.2 mbsf", "baseDepthRaw": "24.0 mbsf", "boundaryBelow": "Unconformity",
      "note": "12.2-24 mbsf；底界为不整合，年龄可在边界处任意跳变，禁止跨边界插值。" },
    { "id": "S-3", "name": "Overturned lower unit", "topDepthRaw": "24.3 mbsf", "baseDepthRaw": "35.0 mbsf", "overturned": true,
      "note": "24.3-35 mbsf 为构造倒转层段：深度越深地层越新，单调方向在层段内反转，边界处重置。" }
  ],
  "boundaries": [
    { "id": "B-GAP", "atDepthRaw": "12.0 mbsf", "kind": "Gap", "name": "Core recovery gap", "note": "11.8-12.2 mbsf 取芯缺口，显式深度缺口边界。" },
    { "id": "B-UNC", "atDepthRaw": "24.15 mbsf", "kind": "Unconformity", "name": "Mid-Pleistocene unconformity", "note": "不整合面，两侧年龄不连续。" }
