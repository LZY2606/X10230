  "ops": [
    { "op": "import", "note": "初始导入：基线完整呈现（深度基准/缺口/分布/储层偏移/事件层/排除决定）" },
    { "op": "freeze", "modelId": "model:KX-01:seg0:cand0", "by": "reviewer-lin", "note": "冻结首选候选" },
    { "op": "freeze", "modelId": "model:KX-01:seg0:cand0", "by": "reviewer-wu", "expect": "conflict", "note": "并发冻结：第二个必须冲突" },
    { "op": "param", "tolerance": 0.08, "maxCandidates": 8, "budget": 10000, "by": "reviewer-lin", "note": "参数修订：单调容差放宽" },
    { "op": "material", "ref": "ra03-v2", "note": "局部源数据改动：ra-03 重测，仅依赖它的模型重算" },
    { "op": "decide", "target": "ra-06", "accept": true, "reason": "保留 ra-06 作为再沉积警示标记", "by": "reviewer-lin", "note": "人工决定 A" },
    { "op": "decide", "target": "ra-06", "accept": false, "reason": "再沉积嫌疑过大，排除出拟合", "by": "reviewer-wu", "note": "人工决定 B（与 A 冲突，两者均保留）" },
    { "op": "propose", "ref": "ra-new", "note": "新锚点影响：与已冻结模型比较" }
  ]
