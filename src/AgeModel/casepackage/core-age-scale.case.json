  "extraMaterials": {
    "ra03-v2": { "kind": "radio-age", "id": "ra-03", "version": 2, "coreId": "KX-01", "depthM": 2.5, "method": "14C", "samplesKa": [3.85,3.92,4.00,4.05,4.08,4.12,4.18,4.25,4.40,4.70,5.05], "unit": "ka BP", "datum": "cal BP1950", "raw": "re-run with IntCal20, tail shortened (UBA-4403R)" },
    "ra-new": { "kind": "radio-age", "id": "ra-new-01", "version": 1, "coreId": "KX-01", "depthM": 1.0, "method": "14C", "samplesKa": [2.00,2.05,2.10,2.15,2.20,2.25,2.30,2.35,2.40,2.45,2.50], "unit": "ka BP", "datum": "cal BP1950", "raw": "new anchor 2.25±0.25 ka (UBA-4501)" }
